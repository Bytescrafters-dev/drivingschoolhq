# Server-only. Origin of the NestJS API; the browser never calls it directly.
BACKEND_URL=http://localhost:8001

# Tenant session cookies. Must differ from the admin dashboard's cookie names
# (browsers don't separate cookies by port).
JWT_COOKIE_NAME=dshq_tenant_at
REFRESH_COOKIE_NAME=dshq_tenant_rt

# Optional cookie domain (leave empty for host-only cookies).
COOKIE_DOMAIN=

# Deployment note: the BFF forwards the browser's IP in X-Forwarded-For and the
# API trusts it via TRUST_PROXY (e.g. `loopback` locally). With trust proxy on,
# the API must only be reachable through this BFF (private network/firewall),
# otherwise clients can spoof X-Forwarded-For and bypass login throttling.
